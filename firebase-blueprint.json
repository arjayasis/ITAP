{
  "entities": {
    "techxQuestion": {
      "title": "TechX Question",
      "description": "Questions submitted by participants for TechX Summit 2026",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "submitterName": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "company": { "type": "string" },
        "question": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" },
        "isSelected": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "live", "answered"] },
        "upvotes": { "type": "number" }
      },
      "required": ["name", "question", "createdAt", "status"]
    },
    "techxRegistration": {
      "title": "TechX Registration",
      "description": "Attendee registration records for TechX Summit 2026 (Student delegates and GMM Industry RSVPs)",
      "type": "object",
      "properties": {
        "registrationId": { "type": "string" },
        "attendeeType": { "type": "string", "enum": ["student", "industry"] },
        "fullName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "college": { "type": "string" },
        "program": { "type": "string" },
        "location": { "type": "string", "enum": ["Manila", "Quezon City"] },
        "yearLevel": { "type": "string" },
        "studentNumber": { "type": "string" },
        "course": { "type": "string" },
        "campus": { "type": "string" },
        "collegeOrDept": { "type": "string" },
        "companyName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "hasCompanion": { "type": "string" },
        "companionName": { "type": "string" },
        "companionDesignation": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["fullName", "email", "mobile", "registrationId"]
    },
    "techxCheckin": {
      "title": "TechX Check-in Attendance",
      "description": "Attendance event check-in records for TechX Summit 2026",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "student_id": { "type": "string" },
        "checkin_type": { "type": "string", "enum": ["qr_scan", "manual_search", "walkin"] },
        "checked_in_at": { "type": "string" },
        "created_by": { "type": "string" },
        "student_name": { "type": "string" },
        "program": { "type": "string" },
        "college": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["id", "student_id", "checkin_type", "checked_in_at"]
    }
  },
  "firestore": {
    "/techx_questions/{questionId}": {
      "schema": "techxQuestion",
      "description": "Real-time interactive Q&A collection for TechX Summit 2026"
    },
    "/techx_registrations/{registrationId}": {
      "schema": "techxRegistration",
      "description": "Event attendee registrations for TechX Summit 2026"
    },
    "/techx_checkins/{checkinId}": {
      "schema": "techxCheckin",
      "description": "Attendance check-in records for TechX Summit 2026"
    }
  }
}
